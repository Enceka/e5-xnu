## @file
#  Publish the Android boot image ramdisk as a read-only block device.
#
#  LK loads the boot image ramdisk into DRAM and records it in the device tree
#  it hands over in x0 (/chosen linux,initrd-start and linux,initrd-end). The
#  UniXNU payload (a FAT image holding the kernel, its .adt, the trust cache
#  and the Data seed) travels in that ramdisk, so DarwinBoot can only read it
#  once something publishes a block device over it. Nothing in this driver
#  knows a hardware address: both ends come from the device tree.
#
#  NOT WIRED IN YET. It is added to e5.dsc/e5.fdf only after the DXE core is
#  confirmed running, because a fault here would hide the EndOfDxe marker.
#
#  @par Revision Reference:
#  Mirrors Platforms/Xiaomi/shengPkg/Drivers/ShengBootMemoryDxe/PublishInitrd.
##

[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = E5PayloadDxe
  FILE_GUID                      = 5D3E8A17-42C6-4B0F-9D85-6A1C7E93B204
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = E5PayloadInitialize

[Sources]
  E5PayloadDxe.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  SiliciumPkg/SiliciumPkg.dec
  UMS9621Pkg/UMS9621Pkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  FdtLib
  HobLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Guids]
  gSiliciumEntryArgHobGuid                       ## CONSUMES

[Protocols]
  gEfiBlockIoProtocolGuid                        ## PRODUCES
  gEfiDevicePathProtocolGuid                     ## PRODUCES

[Depex]
  TRUE
