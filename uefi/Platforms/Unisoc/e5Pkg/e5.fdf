##
#  Flash description for the Rongyue E5 (Unisoc UMS9621).
#
#  FD_BASE, FD_SIZE and FD_BLOCKS are supplied on the build command line
#  (the stuart wrapper build_uefi.py does it from Resources/Configs/<device>.toml;
#  a bare "build" invocation needs -D FD_BASE=... -D FD_SIZE=... -D FD_BLOCKS=...).
#
#  FD_BASE is 0x80800000: LK always loads the boot image to 0x80080000 and jumps
#  there, BootShim sits at that address with the whole FD appended right behind
#  it, so the copy destination has to clear the shim image entirely.  With a
#  4 MiB FD that means 0x80800000, leaving 0x80080000..0x80800000 for the shim
#  and its payload.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[FD.SILICIUM_UEFI]
BaseAddress   = $(FD_BASE)|gArmTokenSpaceGuid.PcdFdBaseAddress
Size          = $(FD_SIZE)|gArmTokenSpaceGuid.PcdFdSize
ErasePolarity = 1

# BlockSize * NumBlocks must equal Size
BlockSize     = 0x1000
NumBlocks     = $(FD_BLOCKS)

0x00000000|$(FD_SIZE)
gArmTokenSpaceGuid.PcdFvBaseAddress|gArmTokenSpaceGuid.PcdFvSize
FV = FVMAIN_COMPACT

[FV.FvMain]
FvNameGuid         = CD8D4C84-20AD-4073-8A28-3400FAE05941
BlockSize          = 0x1000
NumBlocks          = 0
FvAlignment        = 8
ERASE_POLARITY     = 1
MEMORY_MAPPED      = TRUE
STICKY_WRITE       = TRUE
LOCK_CAP           = TRUE
LOCK_STATUS        = TRUE
WRITE_DISABLED_CAP = TRUE
WRITE_ENABLED_CAP  = TRUE
WRITE_STATUS       = TRUE
WRITE_LOCK_CAP     = TRUE
WRITE_LOCK_STATUS  = TRUE
READ_DISABLED_CAP  = TRUE
READ_ENABLED_CAP   = TRUE
READ_STATUS        = TRUE
READ_LOCK_CAP      = TRUE
READ_LOCK_STATUS   = TRUE

  !include Include/APRIORI.inc
  !include Include/DXE.inc

  # RAM Manager: turns the MemoryMapLib table into HOBs and installs the
  # EFI_MEMORY_ATTRIBUTE style regions DXE core needs.
  INF SiliciumPkg/Drivers/RamManagerDxe/RamManagerDxe.inf

  # SMBIOS
  INF MdeModulePkg/Universal/SmbiosDxe/SmbiosDxe.inf
  INF SiliciumPkg/Drivers/SmBiosTableDxe/SmBiosTableDxe.inf

  # ACPI: table infrastructure only, no platform tables yet.
  INF MdeModulePkg/Universal/Acpi/AcpiTableDxe/AcpiTableDxe.inf
  INF MdeModulePkg/Universal/Acpi/AcpiPlatformDxe/AcpiPlatformDxe.inf
  INF MdeModulePkg/Universal/Acpi/BootGraphicsResourceTableDxe/BootGraphicsResourceTableDxe.inf

  # Device tree: consumes the vendor FDT that LK passes in x0, via the
  # gSiliciumEntryArgHobGuid HOB that SEC records.
  INF EmbeddedPkg/Drivers/DtPlatformDxe/DtPlatformDxe.inf

  # Bring-up probe: at the end of DXE dispatch it dumps the memory map and the
  # GOP mode it found, then resets so LK rolls the slot back to Android and the
  # ramoops log can be read.  Without it a firmware that reaches BDS just sits
  # there waiting for a key press, which is indistinguishable from a hang.
  INF UMS9621Pkg/Drivers/E5BringupDxe/E5BringupDxe.inf

[FV.FVMAIN_COMPACT]
FvAlignment        = 8
ERASE_POLARITY     = 1
MEMORY_MAPPED      = TRUE
STICKY_WRITE       = TRUE
LOCK_CAP           = TRUE
LOCK_STATUS        = TRUE
WRITE_DISABLED_CAP = TRUE
WRITE_ENABLED_CAP  = TRUE
WRITE_STATUS       = TRUE
WRITE_LOCK_CAP     = TRUE
WRITE_LOCK_STATUS  = TRUE
READ_DISABLED_CAP  = TRUE
READ_ENABLED_CAP   = TRUE
READ_STATUS        = TRUE
READ_LOCK_CAP      = TRUE
READ_LOCK_STATUS   = TRUE

  INF SiliciumPkg/Sec/Sec.inf

  FILE FV_IMAGE = 9E21FD93-9C72-4c15-8C4B-E77F1DB2D792 {
    SECTION GUIDED EE4E5898-3914-4259-9D6E-DC7BD79403CF PROCESSING_REQUIRED = TRUE {
      SECTION FV_IMAGE = FVMAIN
    }
  }

  !include SiliciumPkg/Common.fdf.inc
